# Every /api/* route checks this as the X-Agent-Password header, and the
# service refuses to start when it is empty. Use a generated value:
#   python -c "import secrets;print(secrets.token_urlsafe(24))"
AGENT_PASSWORD=change_me

SQLITE_PATH=data/risk_agent.db

# Hosts whose contract attachments may be downloaded, comma separated.
# LEAVE EMPTY TO DOWNLOAD NOTHING. Attachment URLs come from a database, and
# database content is untrusted input: without this allowlist a URL edited
# upstream could make the fetcher reach an internal address (SSRF).
# Only https is fetched, hosts resolving to private addresses are refused,
# redirects are refused, and only .pdf/.docx/.xlsx/.doc are retrieved.
CONTRACT_ATTACHMENT_HOSTS=
CONTRACT_ATTACHMENT_DIR=data/contract-attachments

# Skip the resolved-address check. Only for machines where an HTTP proxy does
# DNS interception, which makes local resolution meaningless because the proxy,
# not this process, dials the host. The host allowlist still applies and remains
# the real control. Every affected result is stamped so a weakened run never
# looks like a guarded one.
CONTRACT_ATTACHMENT_ALLOW_PRIVATE=

# Any OpenAI-compatible endpoint. Leave empty to run without an LLM: every
# component degrades to its deterministic path rather than failing.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ------------------------------------------------------------ conversation memory
# All optional. Retrieval needs qdrant-client and fastembed; without them the
# system degrades and the deterministic layers carry on.
#
# Qdrant runs in embedded file mode - no separate process, no port - and
# embedding happens locally through ONNX, so text is never sent to a
# third-party embedding service.
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=risk_agent_memory
EMBEDDING_VERSION=1
# Must match the model's real output dimension or the index refuses writes.
EMBEDDING_DIMENSION=384
MEMORY_RECENT_MESSAGES=12
MEMORY_CONTEXT_CHARS=12000
MEMORY_RETRIEVAL_LIMIT=6
